# ============================================================
# DataCollector — переменные окружения.
# Скопируйте в .env и заполните:  cp .env.example .env
# ============================================================

# --- PostgreSQL (значения по умолчанию совпадают с docker-compose.yml) ---
POSTGRES_USER=datacollector
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datacollector

# Строка подключения для локальной разработки (порт проброшен на 127.0.0.1).
# В docker-compose для сервисов api/worker DATABASE_URL переопределяется на хост postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datacollector?schema=public

# --- Шифрование storageState (AES-256-GCM) ---
# 32 байта в hex (64 символа). Сгенерировать: openssl rand -hex 32
# Один ключ на окружение; смена ключа инвалидирует сохранённые сессии (потребуется перелогин).
SESSION_ENCRYPTION_KEY=

# --- Учётные записи источников (использует worker) ---
# МГЭ — своя форма логина на expertiza.mos.ru
MGE_LOGIN=
MGE_PASSWORD=
# СУДИР — один аккаунт, общая сессия для МГЗ / СУИД / Дашборда
SUDIR_LOGIN=
SUDIR_PASSWORD=

# --- Сайты источников (переопределяются для тестов на mock-сервере) ---
# МГЭ
MGE_BASE_URL=https://expertiza.mos.ru
# MGE_LOGIN_URL=https://expertiza.mos.ru        # страница входа (по умолчанию = MGE_BASE_URL)
# Селекторы поиска объекта (через запятую, перебираются по порядку).
# Уточняются по результатам POST /api/diagnostics/mge
MGE_SEARCH_SELECTORS=input[type="search"], input[placeholder*="поиск" i], input[name="query"], input[name="search"]
# Селекторы формы логина МГЭ (по умолчанию — типовые input[name=login]/password)
# MGE_LOGIN_USER_SELECTOR=input[name="login"]
# MGE_LOGIN_PASSWORD_SELECTOR=input[name="password"]
# MGE_LOGIN_SUBMIT_SELECTOR=button[type="submit"]
# Сайты СУДИР (шаг 5)
# MGZ_BASE_URL=https://mgz.mos.ru
# SUID_BASE_URL=https://suid.mos.ru
# DASHBOARD_BASE_URL=https://dashboard-stroi.mos.ru
# SUDIR_LOGIN_START_URL=https://mgz.mos.ru

# --- Google Sheets (инструкция по credentials — README, раздел «Google Sheets / Яндекс») ---
# Путь относительно КОРНЯ репозитория (в контейнере монтируется ./secrets:/app/secrets:ro)
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
# id таблицы из URL: https://docs.google.com/spreadsheets/d/<ВОТ_ЭТОТ_ID>/edit
GOOGLE_SPREADSHEET_ID=
# Имя листа (пусто = первый лист)
GOOGLE_SHEET_NAME=
# Без сервисного аккаунта можно читать таблицу с доступом «все, у кого есть ссылка»
# (публичный CSV-экспорт). Шаблон URL можно переопределить (например, для тестов):
# GOOGLE_CSV_URL_TEMPLATE=https://docs.google.com/spreadsheets/d/{id}/export?format=csv
# GOOGLE_API_BASE_URL=https://sheets.googleapis.com

# --- Яндекс Таблицы 360 ---
# Публичной документированной версии API нет — эндпоинт настраивается шаблоном.
# YANDEX_TABLES_URL_TEMPLATE=https://tables360.yandex.ru/api/books/{book_id}/views/{view_id}/rows
YANDEX_OAUTH_TOKEN=
YANDEX_TABLES_BOOK_ID=
YANDEX_TABLES_VIEW_ID=

# --- Табличные источники: маппинг колонок (общий для gsheets/yandex) ---
# По умолчанию — «широкий» формат: строка = объект, каждая колонка (кроме
# «Наименование…»/«Код ДС») = метрика. Для «длинного» формата задайте JSON:
# TABULAR_MAPPING_JSON={"objectColumns":["Объект"],"codeColumn":"Код ДС","keyColumn":"Показатель","valueColumn":"Значение","unitColumn":"Ед. изм.","periodColumn":"Период","prefix":""}

# --- МГЭ: переименование метрик (JSON: путь в ответе → канонический ключ) ---
# MGE_METRIC_MAP={"indicators.readiness_pct":"Готовность проекта, %"}

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
# Доверять X-Forwarded-For от nginx (IP-allowlist для POST /api/collect и /api/diagnostics/mge)
API_TRUST_PROXY=true
# Каталог шаблонов справок (в docker монтируется ./templates:/app/templates:ro)
REPORTS_TEMPLATES_DIR=./templates
# IP/CIDR через запятую, которым разрешён POST /api/collect и POST /api/diagnostics/mge.
# Пусто = только localhost. Для LAN добавьте свою подсеть, например: 127.0.0.1,::1,192.168.1.0/24
COLLECT_ALLOWED_IPS=127.0.0.1,::1

# --- Воркер ---
# Cron суточного сбора (pg-boss schedule) — обязательный fallback ручного запуска.
CRON_SCHEDULE=0 2 * * *
CRON_TZ=Europe/Moscow
WORKER_CONCURRENCY=2
# Обновлять v_metrics_unified не после каждой задачи, а раз в N завершённых задач
# (финальный REFRESH всегда выполняется по завершении пачки), чтобы не грузить БД.
REFRESH_MATVIEW_EVERY=25

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=60000

# --- Прочее ---
NODE_ENV=development
LOG_LEVEL=info
TZ=Europe/Moscow
