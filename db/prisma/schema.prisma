// =====================================================================
// DataCollector — схема БД (PostgreSQL).
//
// Кастомные SQL-объекты, которые Prisma не моделирует, живут в миграциях:
//   db/prisma/migrations/20261106090001_views/migration.sql
//     — v_metrics_unified (materialized view) + refresh_unified_view()
// Доступ к ним из кода — через prisma.$queryRaw / $executeRaw.
//
// Конвенции:
//   * period TEXT NOT NULL DEFAULT ''  — непериодические метрики хранят '',
//     чтобы NULL не ломал уникальный индекс и оконные функции view.
//   * collected_at задаётся ОДИН на пачку метрик (shared/src/metrics.ts,
//     NormalizedBatchSchema) — ключ идемпотентности upsert.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Строительные объекты (~1000) ─────────────────────────────────────────
// Идентификаторы из выгрузки СУИД (import:objects, миграция 0005):
//   suid_id  — «Идентификатор проекта» (hex), колонка A
//   code_ds  — «Код ДС», колонка C
//   uin      — «УИН», колонка D
// UNIQUE на nullable-колонках: PostgreSQL допускает много NULL.
// import_batch_id + excel_row_hash — идемпотентность повторного импорта.
// external_ids хранит ТОЛЬКО внутренние ID сайтов (mge_id, mgz_id, dashboard_id…).

model Object {
  id             Int      @id @default(autoincrement())
  name           String
  address        String?
  codeDs         String?  @unique @map("code_ds")
  uin            String?  @unique
  suidId         String?  @unique @map("suid_id")
  importBatchId  String?  @map("import_batch_id") @db.Uuid
  excelRowHash   String?  @map("excel_row_hash")
  // Внутренние ID объектов в системах источников:
  // {"mge_id": "...", "mgz_id": "...", "dashboard_id": "...", "suid_internal_id": "..."}
  externalIds    Json     @default("{}") @map("external_ids")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  collectionJobs   CollectionJob[]
  metricsMge       MetricMge[]
  metricsMgz       MetricMgz[]
  metricsSuid      MetricSuid[]
  metricsDashboard MetricDashboard[]
  metricsGsheets   MetricGsheets[]
  metricsYandex    MetricYandex[]

  @@map("objects")
}

// ─── Источники данных (справочник, сидируется миграцией 0003) ─────────────
// code='sudir' — ТОЛЬКО авторизация: общий storageState для МГЗ/СУИД/Дашборда,
// таблицы метрик не имеет и в v_metrics_unified не участвует.
// Строки не удалять (только enabled=false) — на них ссылаются jobs/sessions.

model Source {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  // Приоритет разрешения конфликтов в v_metrics_unified: больше — авторитетнее.
  priority  Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions       Session[]
  collectionJobs CollectionJob[]

  @@map("sources")
}

// ─── Показатели по источникам (6 таблиц единой структуры) ─────────────────
// Уникальный индекс (object_id, metric_key, period, collected_at) — основа
// идемпотентного upsert (ON CONFLICT DO UPDATE). Индекс (collected_at) —
// для выборок истории и очистки старых срезов.

model MetricMge {
  id             BigInt   @id @default(autoincrement())
  objectId       Int      @map("object_id")
  metricKey      String   @map("metric_key")
  metricValue    String?  @map("metric_value")
  // Числовое представление metric_value (если метрика числовая) — для сортировки/агрегации в SPA
  metricValueNum Float?   @map("metric_value_num")
  unit           String?
  period         String   @default("")
  collectedAt    DateTime @map("collected_at") @db.Timestamptz(3)
  rawPayload     Json?    @map("raw_payload")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, metricKey, period, collectedAt], map: "metrics_mge_upsert_key")
  @@index([collectedAt], map: "metrics_mge_collected_at_idx")
  @@map("metrics_mge")
}

