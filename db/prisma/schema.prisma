// ─── Журнал задач сбора (доменный уровень, дополняет внутренние таблицы pg-boss) ──
// run_id группирует задачи одного запуска (кнопка в SPA или cron).
// DEAD — dead-letter: попытки исчерпаны.

model CollectionJob {
  id          BigInt    @id @default(autoincrement())
  runId       String    @map("run_id") @db.Uuid
  bossJobId   String?   @map("boss_job_id")
  objectId    Int       @map("object_id")
  sourceId    Int       @map("source_id")
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  error       String?
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id])

  @@index([runId, status], map: "collection_jobs_run_id_status_idx")
  @@index([objectId, createdAt], map: "collection_jobs_object_id_created_at_idx")
  @@index([status, updatedAt], map: "collection_jobs_status_updated_at_idx")
  @@map("collection_jobs")
}

// ─── Авторизационные сессии (storageState Playwright, зашифрованные) ──────
// По одной записи на источник АВТОРИЗАЦИИ: 'mge' и 'sudir'
// (СУДИР один на МГЗ/СУИД/Дашборд). Шифрование AES-256-GCM в коде worker:
// iv(12B) || authTag(16B) || ciphertext, ключ — env SESSION_ENCRYPTION_KEY.

model Session {
  id                    Int       @id @default(autoincrement())
  sourceId              Int       @unique @map("source_id")
  storageStateEncrypted Bytes?    @map("storage_state_encrypted")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz(3)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  DEAD
}
